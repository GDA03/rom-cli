}
POPULAR_FILE = os.path.join(CACHE_DIR, "popular.json")
POPULAR_TTL = 30 * 86400
PORTS_FILE = os.path.join(CACHE_DIR, "switchports.json")
PORTS_TTL = 7 * 86400
PORTS_VER = 2
PORTS_CACHE = None
INDEX_FILE = os.path.join(CACHE_DIR, "switchindex.json")
INDEX_TTL = 7 * 86400
INDEX_VER = 1
INDEX_CACHE = None
POPULAR = None
POPULAR_NORM = None
LABEL_KEY = {}
for _k, _v in PLATFORM_LABELS.items():
    LABEL_KEY.setdefault(_v, _k)


def _wiki_raw(title, depth=0):
    st, _, body = request(f"https://en.wikipedia.org/w/index.php?title={title}&action=raw",
                          retries=2, timeout=40)
    if st != 200 or depth > 2:
        return ""
    text = body.decode("utf-8", "replace")
    m = re.match(r"\s*#REDIRECT\s*\[\[([^\]]+)\]\]", text, re.I)
    if m:
        return _wiki_raw(urllib.parse.quote(m.group(1).replace(" ", "_")), depth + 1)
    return text


_WIKI_ATTR = re.compile(r'^[|!]\s*(?:[A-Za-z_:][\w:.-]*\s*=\s*'
                        r'(?:"[^"]*"|\'[^\']*\'|[^\s|]+)\s*)*\|?\s*')
_WIKI_LINK = re.compile(r"\[\[([^\]\|#]+)(?:\|([^\]]+))?\]\]")
_WIKI_SALES = (re.compile(r"\{\{nts\|([\d.,]+)\}\}"),
               re.compile(r"\{\{val\|([\d.,]+)"),
               re.compile(r"\b(\d{1,3}(?:,\d{3}){1,}|\d{6,})\b"))


def _wiki_tables(text):
    out, cur, depth = [], None, 0
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("{|"):
            if depth == 0:
                cur = []
            depth += 1
        if cur is not None:
            cur.append(line)
        if s.startswith("|}"):
            depth = max(0, depth - 1)
            if depth == 0 and cur is not None:
                out.append(cur)
                cur = None
    return out


def _wiki_rows(lines):
    rows, cur = [], None

    def flush(cells):
        if not cells:
            return
        title, sales = None, 0.0
        for cell in cells:
            body = _WIKI_ATTR.sub("", cell.strip(), count=1)
            if title is None:
                m = _WIKI_LINK.search(body)
                if m:
                    title = re.sub(r"''", "", m.group(2) or m.group(1))
                    title = re.sub(r"&nbsp;|&#160;|\u00a0", " ", title)
                    title = re.sub(r"\s+", " ", title).strip()
            if sales == 0.0:
                for pat in _WIKI_SALES:
                    mm = pat.search(body)
                    if mm:
                        try:
                            sales = float(mm.group(1).replace(",", ""))
                        except ValueError:
                            sales = 0.0
                        if sales:
                            break
        if title and sales > 0:
            rows.append(title)

    for line in lines:
        s = line.strip()
        if s == "|-":
            flush(cur)
            cur = []
        elif cur is not None and s.startswith(("|", "!")):
            cur.append(line)
    flush(cur)
    return rows


def _parse_wiki(text):
    best = []
    for tbl in _wiki_tables(text):
        rows = _wiki_rows(tbl)
        if len(rows) > len(best):
            best = rows
    return best


def load_popular(force=False):
    global POPULAR, POPULAR_NORM
    if POPULAR is not None and not force:
        return POPULAR
    if not force and os.path.exists(POPULAR_FILE):
        try:
            d = json.load(open(POPULAR_FILE))
            if time.time() - d.get("fetched_at", 0) < POPULAR_TTL and d.get("data"):
                POPULAR = d["data"]
                POPULAR_NORM = None
                return POPULAR
        except Exception:
            pass
    data = {}
    for pk, page in WIKI_LISTS.items():
        try:
            titles = _parse_wiki(_wiki_raw(page))
        except Exception:
            titles = []
        seen, ranked = set(), []
        for t in titles:
            nt = norm(t)
            if nt and nt not in seen:
                seen.add(nt)
                ranked.append(t)
        if ranked:
            data[pk] = ranked
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = POPULAR_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"fetched_at": time.time(), "data": data}, f)
        os.replace(tmp, POPULAR_FILE)
    except Exception:
        pass
    POPULAR = data
    POPULAR_NORM = None
    return data


def _pop_norm(pk):
    global POPULAR_NORM
    if POPULAR_NORM is None:
        POPULAR_NORM = {}
    if pk not in POPULAR_NORM:
        POPULAR_NORM[pk] = {norm(t): i for i, t in enumerate((POPULAR or {}).get(pk, []))}
    return POPULAR_NORM[pk]


def pop_rank(pk, title):
    nt = norm(title)
    if not nt:
        return None
    m = _pop_norm(pk)
    if not m:
        return None
    return m.get(nt)


def annotate_popular(results):
    load_popular()
    for r in results:
        pk = r.meta.get("pk") or LABEL_KEY.get(r.platform)
        if not pk or any(b in r.title.lower() for b in BAD):
            continue
        rk = pop_rank(pk, r.title)
        if rk is not None:
            r.meta["pop"] = rk
    return results


KIND_ORDER = {"Base": 0, "": 1, "Port": 1, "Update": 2, "DLC": 3}


def browse_items(platform_key):
    if platform_key == "switchports":
        return sorted(SOURCES["archive.org"].port_results(), key=lambda r: norm(r.title))
    pk = platform_key
    pair = next(((s, a) for s, a in PLATFORMS[pk] if hasattr(SOURCES[s], "all_items")), None)
    if pair:
        items = SOURCES[pair[0]].all_items(pair[1])
    else:
        load_popular()
        titles = (POPULAR or {}).get(pk) or []
        if not titles:
            raise RuntimeError(f"{PLATFORM_LABELS.get(pk, pk)}: no listing — use the search")
        return [Result("", t, PLATFORM_LABELS.get(pk, pk), "",
                       meta={"pk": pk, "pop": i, "search_title": t})
                for i, t in enumerate(titles)]
    load_popular()
    if (POPULAR or {}).get(pk):
        def key(r):
            kind = KIND_ORDER.get(r.kind, 1)
            size = -int(r.meta.get("bytes") or 0)
            rk = None if any(b in r.title.lower() for b in BAD) else pop_rank(pk, r.title)
            if rk is not None:
                r.meta["pop"] = rk
                return (0, rk, kind, size, norm(r.title))
            return (1, 0, kind, size, norm(r.title))
        items.sort(key=key)
    return items


def run_tui(platform_key="", query="", outdir=None, force=False):
    from textual.app import App, ComposeResult
    from textual.widgets import (Input, DataTable, Footer, Header, Static, OptionList, ProgressBar,
                                 RadioSet, RadioButton, SelectionList, TextArea, Label)
    from textual.widgets.option_list import Option
    from textual.widgets.selection_list import Selection
    from textual.screen import ModalScreen
    from textual.containers import Vertical, VerticalScroll, Horizontal
    from textual.binding import Binding

    outdir = outdir or OUT_DIR

    class OptionsScreen(ModalScreen):
        CSS = """
        OptionsScreen { align: center middle; background: $background 60%; }
        #opts { width: 64; height: auto; max-height: 80%; background: $surface;
                border: round $primary; padding: 1 2; }
        #opts-title { text-style: bold; margin-bottom: 1; }
        #opts-list { height: auto; }
        #opts-hint { text-style: dim italic; margin-top: 1; }
        """
        BINDINGS = [Binding("escape", "cancel", "Close"),
                    Binding("ctrl+b", "cancel", "Close", show=False),
                    Binding("q", "cancel", "Close", show=False)]

        def __init__(self, options):
            super().__init__()
            self.options = options

        def compose(self) -> ComposeResult:
            with Vertical(id="opts"):
                yield Static("Options", id="opts-title")
                yield OptionList(*[Option(o[0], id=o[1]) for o in self.options], id="opts-list")
                yield Static("↑↓ move · Enter select · esc close", id="opts-hint")

        def on_option_list_option_selected(self, event):
            self.dismiss(event.option_id)

        def action_cancel(self):
            self.dismiss(None)

    PICKER_HEAD = ("switch", "ps4", "ps2", "gba", "nds", "psp")

    class PlataformasScreen(OptionsScreen):
        def compose(self) -> ComposeResult:
            with Vertical(id="opts"):
                yield Static("Platform", id="opts-title")
                yield Input(placeholder="type to filter…", id="opts-filter")
                yield OptionList(id="opts-list")
                yield Static("type to filter · ↑↓ move · Enter choose · esc close", id="opts-hint")

        def on_mount(self):
            rest = sorted(k for k in PLATFORM_LABELS if k not in PICKER_HEAD)
            self.all_opts = ([("All", "all")] + [(PLATFORM_LABELS[k], k) for k in PICKER_HEAD]
                             + [(PLATFORM_LABELS[k], k) for k in rest])
            self._filter("")
            self.query_one("#opts-filter", Input).focus()

        def _filter(self, text):
            ol = self.query_one(OptionList)
            ol.clear_options()
            t = text.strip().lower()
            ol.add_options([Option(lbl, id=i) for lbl, i in self.all_opts
                            if not t or t in lbl.lower() or t in i])
            if ol.option_count:
                ol.highlighted = 0

        def on_input_changed(self, event):
            self._filter(event.value)

        def on_input_submitted(self, event):
            ol = self.query_one(OptionList)
            if ol.highlighted is not None:
                self.dismiss(ol.get_option_at_index(ol.highlighted).id)

        def on_key(self, event):
            # arrows move the list while typing goes to the filter
            if event.key in ("up", "down"):
                ol = self.query_one(OptionList)
                (ol.action_cursor_up if event.key == "up" else ol.action_cursor_down)()
                event.stop()

    class DetailScreen(ModalScreen):
        CSS = """
        DetailScreen { align: center middle; background: $background 60%; }
        #det { width: 96; height: 90%; background: $surface; border: round $primary; padding: 0 1; }
        #det-head { text-style: bold; }
        #det-sub { color: $text-muted; margin-bottom: 1; }
        .det-h { text-style: bold; margin-top: 1; }
        RadioSet, SelectionList { height: auto; max-height: 12; width: 100%; }
        #det-links { height: 8; }
        #det-hint { text-style: dim italic; }
        """
        BINDINGS = [Binding("escape", "cancel", "Close"),
                    Binding("ctrl+d", "queue", "Queue picks"),
                    Binding("ctrl+s", "queue", "Queue picks", show=False)]

        def __init__(self, result, extras, files, vr=None):
            super().__init__()
            self.r, self.extras, self.files = result, extras, files
            self.alts = result.meta.get("alts") or []
            # vr: the row whose versions are listed (a merged alt when the top row has none)
            self.vr = vr or result
            ch = self.vr.meta.get("choices") or []
            self.base_idx = [i for i, c in enumerate(ch) if c["kind"] == "Base"]
            self.extra_idx = [i for i, c in enumerate(ch) if c["kind"] in ("Update", "DLC")]

        def compose(self) -> ComposeResult:
            r = self.vr  # the source that carries versions (may be a merged alt)
            ch = r.meta.get("choices") or []
            src = SOURCES.get(r.source)
            how = "direct download" if getattr(src, "direct", True) else "host links only (browser)"
            with VerticalScroll(id="det"):
                yield Static(self.r.title, id="det-head")
                tid = f" · {r.meta['tid']}" if r.meta.get("tid") else ""
                yield Static(f"{r.platform} · {r.source} · {how}{tid}", id="det-sub")
                if self.alts:
                    yield Label("Source (versions below are for the first source with a version list)",
                                classes="det-h")
                    with RadioSet(id="det-src"):
                        for i, a in enumerate([self.r] + self.alts):
                            yield RadioButton(a.source, value=a is r)
                if ch:
                    yield Label("Base", classes="det-h")
                    if self.base_idx:
                        with RadioSet(id="det-base"):
                            for i in self.base_idx:
                                c = ch[i]
                                yield RadioButton(f"{c['label']}  {c['size']}", value=bool(c.get("default")))
                    else:
                        yield Static("base not available in this source")
                    if self.extra_idx:
                        yield Label("Updates & DLC", classes="det-h")
                        yield SelectionList(*[Selection(f"{ch[i]['label']}  {ch[i]['size']}", i,
                                                        bool(ch[i].get("default")))
                                              for i in self.extra_idx], id="det-extra")
                elif self.files:
                    yield Label("Version", classes="det-h")
                    d = SOURCES["romsfun"].default_file(self.files)
                    with RadioSet(id="det-file"):
                        for i, (_u, lbl) in enumerate(self.files):
                            yield RadioButton(lbl[:80], value=i == d)
                if self.extras:
                    yield Label("Manual links (open in a browser)", classes="det-h")
                    yield TextArea("\n".join(f"{c['kind']:<6} {c['url']}" for c in self.extras),
                                   read_only=True, soft_wrap=False, id="det-links")
                yield Static("space/enter choose · ctrl+d queue · esc close", id="det-hint")

        def action_cancel(self):
            self.dismiss(None)

        def action_queue(self):
            rows = [self.r] + self.alts
            r = self.vr
            if self.alts:
                rs = self.query_one("#det-src", RadioSet)
                chosen = rows[rs.pressed_index if rs.pressed_index >= 0 else rows.index(r)]
                if chosen is not r:  # a source without the version list: its own defaults apply
                    self.dismiss([chosen])
                    return
            ch = r.meta.get("choices") or []
            if ch:
                picked = []
                if self.base_idx:
                    rs = self.query_one("#det-base", RadioSet)
                    if rs.pressed_index >= 0:
                        picked.append(self.base_idx[rs.pressed_index])
                if self.extra_idx:
                    picked += list(self.query_one("#det-extra", SelectionList).selected)
                r.meta["picked"] = picked
            elif self.files:
                rs = self.query_one("#det-file", RadioSet)
                r.meta["picked"] = [max(rs.pressed_index, 0)]
            self.dismiss([r])

    class QueueRow(Horizontal):
        DEFAULT_CSS = """
        QueueRow { height: 1; }
        QueueRow .q-title { width: 44; }
        QueueRow ProgressBar { width: 34; }
        QueueRow .q-msg { width: 1fr; color: $text-muted; }
        """

        def __init__(self, job):
            super().__init__()
            self.job = job

        def compose(self) -> ComposeResult:
            yield Static(self.job["title"][:42], classes="q-title")
            yield ProgressBar(total=None, show_eta=False, show_percentage=False, id=f"pb{self.job['id']}")
            yield Static("queued", classes="q-msg")


    class RomApp(App):
        TITLE = "rom"
        CSS = """
        Input { dock: top; }
        #status { height: 1; background: $surface; padding: 0 1; }
        #queue { height: auto; max-height: 8; border-top: solid $primary; display: none; }
        #queue.show { display: block; }
        Footer { dock: bottom; }
        DataTable { height: 1fr; }
        """
        BINDINGS = [
            Binding("d", "download", "Download"),
            Binding("i", "detail", "Details"),
            Binding("space", "toggle", "Mark"),
            Binding("slash", "focus_search", "Search"),
            Binding("p", "platform", "Platform"),
            Binding("n", "next_page", "Page+"),
            Binding("b", "prev_page", "Page-"),
            Binding("ctrl+b", "palette", "Options"),
            Binding("x", "cancel_job", "Cancel dl"),
            Binding("w", "toggle_queue", "Queue", show=False),
            Binding("ctrl+a", "select_all", "Mark all", show=False),
            Binding("ctrl+n", "select_none", "Clear", show=False),
            Binding("q", "quit", "Quit"),
        ]

        def __init__(self, platform_key, query, outdir, force):
            super().__init__()
            self.results = []
            self.selected = set()
            self.last_query = ""
            self.pk = platform_key or ""
            self.initial_query = query or ""
            self.outdir = outdir
            self.force = force
            self.browse_items = None
            self.page = 0
            self.jobs, self.job_seq, self.job_lock = [], 0, threading.Lock()
            self.worker = None

        def compose(self) -> ComposeResult:
            yield Header(show_clock=True)
            yield Input(placeholder="Type the game name and press Enter…  (p switches platform)")
            yield DataTable(cursor_type="row")
            yield VerticalScroll(id="queue")
            yield Static("", id="status")
            yield Footer()

        def on_mount(self):
            self.col_keys = []
            self._busy = None
            self._frame = 0
            self.set_interval(0.1, self._tick)
            self._set_status(self._hint())
            self.query_one(Input).focus()
            if self.initial_query:
                self.query_one(Input).value = self.initial_query
                self._start_search(self.initial_query)
            elif self.pk:
                self._start_browse(self.pk)
            else:
                self.call_after_refresh(self._open_platforms)

        def _tick(self):
            if not self._busy:
                return
            frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
            self._frame += 1
            self.query_one("#status", Static).update(f"{frames[self._frame % len(frames)]} {self._busy}")

        def _hint(self):
            return "platform: " + (PLATFORM_LABELS.get(self.pk, self.pk) if self.pk else "All")

        def _set_status(self, msg):
            self._busy = None
            self.query_one("#status", Static).update(msg)

        def _busy_msg(self, msg):
            self._busy = msg

        def on_input_submitted(self, event):
            q = event.value.strip()
            if q:
                self._start_search(q)

        def _start_search(self, q):
            self.last_query = q
            self.selected.clear()
            self._busy = f"searching for '{q}'…"
            self.query_one("#status", Static).update(f"⠋ searching for '{q}'…")
            threading.Thread(target=self._search_bg, args=(q,), daemon=True).start()

        def _search_bg(self, q):
            try:
                results = search(
                    q, self.pk or None,
                    on_progress=lambda d, t: self._busy_msg(f"building the catalog index… {d}/{t}"),
                    force=self.force)
                self.force = False
                self.call_from_thread(self._show, merge_dupes(rank(results, q)))
            except Exception as e:
                self.call_from_thread(self._set_status, f"✖ search error: {e}")

        def _show(self, results):
            self.browse_items = None
            self.results = results
            self._fill(results[:200])
            if not results:
                msg = "nothing found"
            elif len(results) > 200:
                msg = f"200 of {len(results)} results"
            else:
                msg = f"{len(results)} results"
            self._set_status(f"{msg} · {self._hint()}")

        def _fill(self, rows):
            # rebuild columns per render: drop Type/Size when no shown row has a value
            table = self.query_one(DataTable)
            table.clear(columns=True)
            cols = [" ", "Title", "Platform"]
            self.show_type = any(r.kind for r in rows)
            self.show_size = any(r.size for r in rows)
            cols += ["Type"] * self.show_type + ["Size"] * self.show_size + ["Source"]
            self.col_keys = table.add_columns(*cols)
            for i, r in enumerate(rows):
                table.add_row(*self._cells(i, r), key=str(i))
            table.focus()

        def _start_browse(self, pk):
            self.last_query = ""
            self.selected.clear()
            self._busy = f"opening {PLATFORM_LABELS.get(pk, pk)}…"
            self.query_one("#status", Static).update(f"⠋ {self._busy}")
            threading.Thread(target=self._browse_bg, args=(pk,), daemon=True).start()

        def _browse_bg(self, pk):
            try:
                self.call_from_thread(self._set_browse, browse_items(pk))
            except Exception as e:
                self.call_from_thread(self._set_status, f"✖ {e}")

        def _set_browse(self, items):
            self.browse_items = items
            self.page = 0
            self._render_page()

        def _render_page(self):
            items = self.browse_items or []
            size = 300
            pages = max(1, (len(items) + size - 1) // size)
            self.page = max(0, min(self.page, pages - 1))
            chunk = items[self.page * size:(self.page + 1) * size]
            self.results = chunk
            self.selected.clear()
            self._fill(chunk)
            self._set_status(f"{self._hint()} · {len(items)} items · page {self.page + 1}/{pages}")

        def action_next_page(self):
            if self.browse_items is None:
                return
            self.page += 1
            self._render_page()

        def action_prev_page(self):
            if self.browse_items is None:
                return
            self.page = max(0, self.page - 1)
            self._render_page()

        def _cells(self, i, r):
            from rich.text import Text as RT
            sel = i in self.selected
            src = SOURCES.get(r.source)
            if src is None:  # best-seller placeholder: judge by the platform's first provider
                src = SOURCES.get((PLATFORMS.get(r.meta.get("pk")) or [("",)])[0][0])
            arrow = "↗" if src is not None and not getattr(src, "direct", True) else "↓"
            mark = RT(f"{'✔' if sel else ' '} {arrow}", style="bold green" if sel else "dim")
            star = "★ " if r.meta.get("pop") is not None else ""
            vals = [star + r.title[:60], r.platform]
            if self.show_type:
                vals.append(r.kind or "-")
            if self.show_size:
                vals.append(r.size or "?")
            vals.append(r.source + (f" +{len(r.meta['alts'])}" if r.meta.get("alts") else "")
                        + (f" · {r.meta['summary']}" if r.meta.get("summary") else ""))
            style = "bold on #1f3d2b" if sel else None
            return [mark] + [RT(str(v), style=style) if style else str(v) for v in vals]

        def _redraw(self):
            table = self.query_one(DataTable)
            for i, r in enumerate(self.results[:200]):
                for ck, val in zip(self.col_keys, self._cells(i, r)):
                    table.update_cell(str(i), ck, val)

        def _status_sel(self):
            n = len(self.selected)
            msg = f"{len(self.results)} results"
            if n:
                msg += f" · ✔ {n} marked"
            self._set_status(f"{msg} · {self._hint()}")

        def action_toggle(self):
            table = self.query_one(DataTable)
            if table.cursor_row is None or not self.results:
                return
            i = table.cursor_row
            self.selected.symmetric_difference_update({i})
            self._redraw()
            self._status_sel()

        def action_select_all(self):
            self.selected = set(range(len(self.results[:200])))
            self._redraw()
            self._status_sel()

        def action_select_none(self):
            self.selected.clear()
            self._redraw()
            self._status_sel()

        def action_platform(self):
            self._open_platforms()

        def action_focus_search(self):
            self.query_one(Input).focus()

        def _open_platforms(self):
            def chosen(val):
                if val is None:
                    return
                self.pk = "" if val == "all" else val
                q = self.query_one(Input).value.strip()
                if q:
                    self._start_search(q)
                elif self.pk:
                    self._start_browse(self.pk)
                else:
                    self._set_status("platform: All · type a name and press Enter")
            self.push_screen(PlataformasScreen([]), callback=chosen)

        def action_palette(self):
            self.push_screen(
                OptionsScreen([
                    ("Download selected", "sel"),
                    ("Download current", "cur"),
                    ("Browse this platform", "browse"),
                    ("Switch platform", "plat"),
                    ("Select all", "all"),
                    ("Clear selection", "none"),
                ]),
                callback=self._palette,
            )

        def _palette(self, choice):
            if choice is None:
                return
            if choice == "sel":
                self._batch([self.results[i] for i in sorted(self.selected)])
            elif choice == "cur":
                self.action_download()
            elif choice == "browse":
                if self.pk:
                    self._start_browse(self.pk)
                else:
                    self.action_platform()
            elif choice == "all":
                self.action_select_all()
            elif choice == "none":
                self.action_select_none()
            elif choice == "plat":
                self.action_platform()

        def on_data_table_row_selected(self, event):
            # DataTable consumes Enter as RowSelected; download just that row, marks untouched
            self.action_download()

        def _current(self):
            table = self.query_one(DataTable)
            if table.cursor_row is None or not self.results:
                return None
            return self.results[table.cursor_row]

        def action_download(self):
            r = self._current()
            if r is not None:
                self._batch([r])

        def action_detail(self):
            r = self._current()
            if r is None:
                return
            self._busy = f"loading details: {r.title[:40]}…"
            threading.Thread(target=self._detail_bg, args=(r,), daemon=True).start()

        def _detail_bg(self, r):
            extras, files, vr = [], None, None
            for s in [r] + (r.meta.get("alts") or []):  # merged rows: every source's links + versions
                src = SOURCES.get(s.source)
                try:
                    if hasattr(src, "extras"):
                        extras += src.extras(s)
                    if vr is None and s.meta.get("choices"):
                        vr = s
                    elif vr is None and s.source == "romsfun":
                        files, vr = src.files(s), s
                except Exception as e:
                    self.call_from_thread(self._set_status, f"✖ details ({s.source}): {e}")
            self.call_from_thread(self._open_detail, r, extras, files, vr)

        def _open_detail(self, r, extras, files, vr=None):
            self._set_status(f"{r.title[:60]} · {self._hint()}")
            self.push_screen(DetailScreen(r, extras, files, vr),
                             callback=lambda rows: rows and self._batch(rows))

        # --- download queue: one worker drains self.jobs; each job is one file -------------
        def _batch(self, rows):
            if not rows:
                self._set_status("nothing selected")
                return
            q = self.query_one("#queue")
            q.add_class("show")
            with self.job_lock:
                for r in rows:
                    for j in expand_choices(r) or [r]:
                        self.job_seq += 1
                        job = {"id": self.job_seq, "title": j.title, "result": j, "state": "queued",
                               "cancel": threading.Event()}
                        self.jobs.append(job)
                        row = QueueRow(job)
                        job["row"] = row
                        q.mount(row)
            self._set_status(f"queued {len(rows)} · {self._queue_summary()}")
            if self.worker is None or not self.worker.is_alive():
                self.worker = threading.Thread(target=self._drain, daemon=True)
                self.worker.start()

        def _queue_summary(self):
            c = {}
            for j in self.jobs:
                c[j["state"]] = c.get(j["state"], 0) + 1
            return " · ".join(f"{v} {k}" for k, v in c.items())

        def _job_ui(self, job, msg=None, read=None, total=None):
            row = job["row"]
            pb = row.query_one(ProgressBar)
            if total:
                pb.update(total=total, progress=read)
            if msg is not None:
                row.query(".q-msg").first().update(msg)

        def _drain(self):
            while True:
                with self.job_lock:
                    job = next((j for j in self.jobs if j["state"] == "queued"), None)
                    if job is None:
                        break
                    job["state"] = "running"

                def prog(read, tot, msg, job=job):
                    self.call_from_thread(self._job_ui, job, msg, read, tot)
                try:
                    path = download(job["result"], self.outdir, on_progress=prog, cancel=job["cancel"])
                    job["state"] = "done"
                    self.call_from_thread(self._job_ui, job, f"✔ {os.path.basename(path)}")
                except Exception as e:
                    job["state"] = "cancelled" if job["cancel"].is_set() else "failed"
                    msg = "✖ cancelled (.part kept)" if job["cancel"].is_set() else f"✖ {e}"
                    self.call_from_thread(self._job_ui, job, msg)
            self.call_from_thread(self._set_status, f"queue finished · {self._queue_summary()} · {self.outdir}")

        def action_cancel_job(self):
            # cancel the running job, else the newest queued one
            with self.job_lock:
                job = (next((j for j in self.jobs if j["state"] == "running"), None)
                       or next((j for j in reversed(self.jobs) if j["state"] == "queued"), None))
                if job is None:
                    return
                job["cancel"].set()
                if job["state"] == "queued":
                    job["state"] = "cancelled"
            if job["state"] == "cancelled":
                self._job_ui(job, "✖ cancelled")

        def action_toggle_queue(self):
            self.query_one("#queue").toggle_class("show")

    RomApp(platform_key, query, outdir, force).run()


def main():
    ap = argparse.ArgumentParser(description="Search and download ROMs/ISOs/Switch games.")
    ap.add_argument("query", nargs="*")
    ap.add_argument("-p", "--platform", help="switch, snes, gba, ps2, nds, wii… (see -l)")
    ap.add_argument("-l", "--platforms", action="store_true", help="list platforms")
    ap.add_argument("-y", "--yes", action="store_true", help="download the best match without asking")
    ap.add_argument("--list", action="store_true", help="list results only")
    ap.add_argument("--print-url", action="store_true", help="print the direct link and exit")
    ap.add_argument("--refresh", action="store_true", help="ignore the caches and refetch")
    ap.add_argument("--index", action="store_true", help="build/print the caches and exit")
    ap.add_argument("-n", "--number", type=int, default=15, help="how many results to show")
    ap.add_argument("-o", "--out", default=OUT_DIR, help="destination folder")
    args = ap.parse_args()

    if args.platforms:
        write("  platforms: " + ", ".join(sorted(PLATFORMS)))
        return 0

    key = (args.platform or "").lower().strip()
    if key and key not in PLATFORMS:
        ap.error(f"unknown platform: {key}\n  use: {', '.join(sorted(PLATFORMS))}")

    if args.index:
        write("  building caches…")
        nps = NPS.load(force=args.refresh,
                       on_progress=lambda d, t: status(f"   NoPayStation {d}/{t}"))
        ports = SOURCES["archive.org"].switch_ports(
            force=args.refresh, on_progress=lambda d, t: status(f"   Switch ports {d}/{t}"))
        files = SOURCES["archive.org"].switch_index(
            force=args.refresh, on_progress=lambda d, t: status(f"   Switch index {d}/{t} items"))
        clear_status()
        write(f"  NoPayStation: {sum(len(v) for v in nps.values())} titles · "
              f"Switch ports: {len(ports)} · Switch index: {len(files)} files")
        write(f"  cache: {CACHE_DIR}")
        pop = load_popular(force=args.refresh)
        top = ", ".join(f"{k}({len(v)})" for k, v in sorted(pop.items()) if v)
        write(f"  best sellers (Wikipedia): {top}")
        return 0

    if not args.query:
        if args.list:
            if not key:
                write("  use -p <platform> (e.g. rom -p switch --list)  ·  or rom -l")
                return 1
            try:
                items = browse_items(key)
            except Exception as e:
                write(f"  ✖ {e}")
                return 1
            show(items, args.number)
            write(f"  {len(items)} items in the {PLATFORM_LABELS.get(key, key)} catalog"
                  " — the TUI (rom) browses everything")
            return 0
        if not sys.stdin.isatty() or not _has_textual():
            write("  type: rom -p switch \"game name\"   (or rom -l)")
            return 0

    query = " ".join(args.query)

    if not query:
        run_tui(key, "", args.out, args.refresh)
        return 0

    status(f"searching for '{query}'…")
    try:
        results = search(query, key or None,
                         on_progress=lambda d, t: status(f"   index {d}/{t} pages"),
                         force=args.refresh)
    except Exception as e:
        clear_status()
        write(f"  ✖ search failed: {e}")
        return 1
    clear_status()

    if not results:
        write("  ✖ nothing found. Try a different name or platform.")
        return 1

    results = rank(results, query)
    outdir = os.path.expanduser(args.out)

    if args.list:
        show(results, args.number)
        return 0

    if args.print_url:
        for r in results[:args.number]:
            write(f"  {r.title} [{r.platform} {r.kind or '-'} {r.size or '?'}]")
            src = SOURCES[r.source]
            if isinstance(src, DlpsGame):
                for u in src.links(r.page):
                    write(f"  {u}")
            else:
                try:
                    url, name = SOURCES[r.source].resolve(r)
                    write(f"  {url}")
                except Exception as e:
                    write(f"  (error: {e})")
            write()
        return 0

    if args.yes or not sys.stdin.isatty():
        show(results, args.number)
        return run_cli_download(results[:1], outdir)

    picked = select_menu(results, args.number)
    if not picked:
        write("  cancelled.")
        return 0
    return run_cli_download(picked, outdir)


def _has_textual():
    try:
        import textual  # noqa: F401
        return True
    except Exception:
        return False


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        clear_status()
        write("\n  cancelled.")
        sys.exit(130)
