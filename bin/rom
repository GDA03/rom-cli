ROM_EXTS = ("zip", "7z", "rar", "nsp", "xci", "nsz", "iso", "cia", "pkg", "rom",
            "bin", "sfc", "smc", "nes", "gba", "gbc", "gb", "nds", "n64", "z64",
            "md", "smd", "gcm", "wbfs", "rvz", "cso", "pbp")
EXT_RE = re.compile(r"\.(" + "|".join(ROM_EXTS) + r")$", re.I)

STOP = {"the", "of", "a", "an", "and", "de", "do", "da", "o", "os", "as", "in",
        "to", "for", "e", "y", "the"}
BAD = ("romhack", "translation", "beta", "prototype", "demo", "sample", "unlicensed",
       "(hack)", "homebrew", "soundtrack", "manual", "emulator")

TTY = sys.stdout.isatty()


def write(text="", newline=True):
    sys.stdout.write(text)
    if newline and not text.endswith("\n"):
        sys.stdout.write("\n")
    sys.stdout.flush()


def status(msg):
    if TTY:
        write(f"\r\033[K  {msg}")
    else:
        write(f"  {msg}\n")


def clear_status():
    if TTY:
        write("\r\033[K")


def human(n):
    if not n:
        return "?"
    n = float(n)
    for unit in ("B", "kB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def norm(s):
    s = unicodedata.normalize("NFKD", s or "")
    s = "".join(c for c in s if not unicodedata.combining(c))
    return re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()


def clean(s):
    s = re.sub(r"<[^>]+>", " ", s or "")
    s = htmllib.unescape(s)
    return re.sub(r"\s+", " ", s).strip()


def significant(words):
    sig = [w for w in words if w not in STOP and len(w) > 1]
    return sig or words


def pretty_title(fn):
    base = EXT_RE.sub("", fn or "")
    base = re.sub(r"\[[^\]]*\]", " ", base)
    base = re.sub(r"\bv\d+(?:\.\d+)*\b", " ", base, flags=re.I)
    base = base.replace("_", " ")
    base = re.sub(r"^\s*download\s+", "", base, flags=re.I)
    base = re.sub(r"\s+", " ", base).strip(" .-")
    return base or (fn or "")


def kind_of(fn):
    low = (fn or "").lower()
    if re.search(r"\bports?\b", low) or "homebrew" in low:
        return "Port"
    if "[dlc" in low or " dlc" in low or "dlc " in low:
        return "DLC"
    if "[up " in low or "upd" in low or "update" in low or re.search(r"\bv\d+", low):
        return "Update"
    if "[base]" in low:
        return "Base"
    return ""


def safe_name(name, fallback, ext):
    base = clean(name) or fallback
    base = EXT_RE.sub("", base)
    base = re.sub(r'[\\/:*?"<>|]', " ", base)
    base = re.sub(r"\s+", " ", base).strip(" .")[:140] or fallback
    return f"{base}{ext}"


def unique_path(path):
    root, ext = os.path.splitext(path)
    i = 2
    while os.path.exists(path):
        path = f"{root} ({i}){ext}"
        i += 1
    return path


def request(url, data=None, headers=None, timeout=40, retries=3, method=None):
    last = None
    for attempt in range(retries):
        req = urllib.request.Request(url, data=data, method=method)
        req.add_header("User-Agent", UA)
        req.add_header("Accept-Language", "en-US,en;q=0.9,pt-BR;q=0.8")
        req.add_header("Accept", "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8")
        for k, v in (headers or {}).items():
            req.add_header(k, v)
        try:
            with urllib.request.build_opener().open(req, timeout=timeout) as r:
                return r.status, r.headers, r.read()
        except urllib.error.HTTPError as e:
            last = e
            if e.code in (429, 500, 502, 503, 504) and attempt + 1 < retries:
                time.sleep(1 + attempt)
                continue
            return e.code, e.headers, e.read()
        except Exception as e:
            last = e
            if attempt + 1 < retries:
                time.sleep(1 + attempt)
    raise last


def stream(url, referer, on_progress, dest, cancel=None):
    part = dest + ".part"
    pos = os.path.getsize(part) if os.path.exists(part) else 0
    req = urllib.request.Request(url)
    req.add_header("User-Agent", UA)
    if referer:
        req.add_header("Referer", referer)
    if pos:
        req.add_header("Range", f"bytes={pos}-")
    with urllib.request.build_opener().open(req, timeout=60) as r:
        resumed = pos and r.status == 206
        if not resumed:
            pos = 0
        total = int(r.headers.get("Content-Length") or 0) + pos
        read = pos
        on_progress(read, total)
        with open(part, "ab" if resumed else "wb") as f:
            while True:
                if cancel is not None and cancel.is_set():
                    raise RuntimeError("cancelled")  # .part stays for resume
                chunk = r.read(1048576)
                if not chunk:
                    break
                f.write(chunk)
                read += len(chunk)
                on_progress(read, total)
    os.replace(part, dest)
    return read


def title_kind(fn):
    m = re.search(r"\[(0100[0-9a-fA-F]{12})\]", fn or "")
    if not m:
        return kind_of(fn)
    tail = m.group(1)[-3:].lower()
    return "Base" if tail == "000" else "Update" if tail == "800" else "DLC"


TID_RE = re.compile(r"\[(0100[0-9a-fA-F]{12})\]")


def base_tid(tid):
    # update = base | 0x800, DLC = base + 0x1000 + n: clearing 0x1FFF yields the base
    return f"{int(tid, 16) & ~0x1FFF:016X}"


def choice_label(fn, kind):
    # ponytail: [vN] is a release counter (N // 65536), not a marketing version like "3.0.3"
    v = re.search(r"\[v(\d+)\]", fn)
    tag = re.search(r"(?<![\d.])v\d+(?:\.\d+)+", fn)
    region = re.search(r"\[(US|EU|JP|USA|EUR|JPN|ASIA|KR|CN|UK|World)\]|\((USA|Europe|Japan|World|Asia|Korea|China)\)", fn)
    ext = fn.rsplit(".", 1)[-1].lower() if "." in fn else ""
    parts = [kind]
    if tag:
        parts.append(tag.group(0))
    elif v and kind == "Update":
        parts.append(f"rev {int(v.group(1)) // 65536}")
    elif v:
        parts.append(f"v{v.group(1)}")
    if region:
        parts.append(region.group(1) or region.group(2))
    parts.append(f".{ext}")
    if kind == "DLC":
        parts.append(pretty_title(re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", fn))[:40])
    return " ".join(parts)


def link_kind(text):
    t = (text or "").lower()
    return ("Update" if re.search(r"upd|update", t) else
            "DLC" if re.search(r"dlc|booster|wave", t) else "Base")


def link_choices(pairs):
    # (url, label-or-url) -> typed link-only choices; host links never resolve automatically here
    return [{"label": f"{link_kind(t)} · {urllib.parse.urlparse(u).netloc}", "kind": link_kind(t),
             "url": u, "direct": False, "size": ""} for u, t in pairs]


class Result:
    __slots__ = ("source", "title", "platform", "size", "page", "meta")

    def __init__(self, source, title, platform, page, size="", meta=None):
        self.source = source
        self.title = title
        self.platform = platform
        self.page = page
        self.size = size
        self.meta = meta or {}

    @property
    def kind(self):
        return self.meta.get("kind", "")

    @property
    def ext(self):
        return self.meta.get("ext", "")


PLATFORM_RE = re.compile(r"^/([a-z0-9\-]+?)-rom-")


class RomsGames:
    name = "romsgames"
    direct = True
    base = "https://www.romsgames.net"

    def search(self, query, prefixes=None):
        url = f"{self.base}/search/hint/?q={urllib.parse.quote_plus(query)}"
        st, _, body = request(url, headers={"X-Requested-With": "XMLHttpRequest",
                                            "Accept": "application/json"}, retries=2)
        if st != 200:
            return []
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except Exception:
            return []
        out, seen = [], set()
        for item in data:
            href = item.get("url") or ""
            pm = PLATFORM_RE.match(href)
            if not pm:
                continue
            prefix = pm.group(1)
            if prefixes and prefix not in prefixes:
                continue
            if href in seen:
                continue
            seen.add(href)
            title = clean(item.get("name") or "")
            if not title:
                continue
            out.append(Result(self.name, title, LABELS.get(prefix, prefix.replace("-", " ").title()),
                              self.base + href, meta={"ext": "zip"}))
        return out

    def resolve(self, result):
        st, _, body = request(result.page, retries=2)
        if st != 200:
            raise RuntimeError(f"page unavailable ({st})")
        page = body.decode("utf-8", "replace")
        action = re.search(r'<form[^>]*id="download-form"[^>]*action="([^"]+)"', page)
        media = re.search(r'data-media-id="(\d+)"', page)
        if not action or not media:
            raise RuntimeError("download button not found")
        form = urllib.parse.urljoin(self.base, action.group(1))
        st, _, body = request(form + "?download",
                              data=f"mediaId={media.group(1)}&g-recaptcha-response=".encode(),
                              headers={"accept": "application/json",
                                       "Content-Type": "application/x-www-form-urlencoded",
                                       "Referer": result.page}, retries=3)
        if st != 200:
            raise RuntimeError(f"download server responded {st}")
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except Exception:
            raise RuntimeError("invalid download response")
        url = data.get("downloadUrl")
        if not url:
            raise RuntimeError("download link missing")
        return url, urllib.parse.unquote(data.get("downloadName") or "")


class RomsFun:
    name = "romsfun"
    direct = True
    base = "https://romsfun.com"
    # ponytail: hardcoded WP `console` term ids; re-read /wp-json/wp/v2/console if romsfun renumbers.
    consoles = {
        "nes": 12, "snes": 6, "n64": 9, "gb": 95, "gbc": 11, "gba": 4, "nds": 3, "3ds": 91,
        "gc": 13, "wii": 10, "wiiu": 86, "ps1": 7, "ps2": 8, "ps3": 15, "psp": 5, "psv": 89,
        "ps4": 87, "genesis": 14, "mastersystem": 9806, "gamegear": 9476, "segacd": 9814,
        "dreamcast": 2390, "saturn": 92, "arcade": 14211, "pc": 9989, "dos": 19282,
        "xbox": 90, "xbox360": 94,
    }
    keys = {v: k for k, v in consoles.items()}

    def search(self, query, pk=None):
        url = (f"{self.base}/wp-json/wp/v2/rom?search={urllib.parse.quote_plus(query)}"
               "&per_page=40&_fields=title,link,console")
        if pk:
            url += f"&console={self.consoles[pk]}"
        st, _, body = request(url, headers={"Accept": "application/json"}, retries=2)
        if st != 200:
            return []
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except Exception:
            return []
        out = []
        for x in data:
            key = next((self.keys[c] for c in x.get("console") or [] if c in self.keys), None)
            title = clean((x.get("title") or {}).get("rendered") or "")
            if key and title and x.get("link"):
                out.append(Result(self.name, title, PLATFORM_LABELS[key], x["link"], meta={"pk": key}))
        return out

    def files(self, result):
        """[(row_url, label)] for every file on the game's download page."""
        if result.meta.get("files") is not None:
            return result.meta["files"]
        st, _, body = request(result.page, retries=2)
        m = re.search(r'href="(https://romsfun\.com/download/[^"/]+)[/"]',
                      body.decode("utf-8", "replace")) if st == 200 else None
        if not m:
            raise RuntimeError(f"download page not found ({st})")
        st, _, body = request(m.group(1), retries=2)
        files = []
        for tr in re.findall(r"<tr[^>]*>(.*?)</tr>", body.decode("utf-8", "replace"), re.S):
            u = re.search(r'href="(https://romsfun\.com/download/[^"]+/\d+)"', tr)
            if u:
                files.append((u.group(1), clean(tr)))
        if not files:
            raise RuntimeError("no files listed")
        result.meta["files"] = files
        return files

    def default_file(self, files):
        clean_files = [f for f in files if "hack" not in f[1].lower()] or files
        return files.index(min(clean_files, key=lambda f: (not re.search(r"\b(USA|World)\b", f[1]),
                                                          len(f[1]))))

    def resolve(self, result):
        files = self.files(result)
        picked = result.meta.get("picked")
        pick = files[picked[0] if picked else self.default_file(files)]
        st, _, body = request(f"{self.base}/wp-admin/admin-ajax.php", data=b"action=k_get_download",
                              headers={"Content-Type": "application/x-www-form-urlencoded",
                                       "Referer": pick[0]}, retries=2)
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except Exception:
            raise RuntimeError(f"invalid download response ({st})")
        d = re.search(r'href="([^"]+)"', (data.get("data") or {}).get("html") or "")
        if not data.get("success") or not d:
            raise RuntimeError((data.get("data") or {}).get("message") or "download link missing")
        url = htmllib.unescape(d.group(1))
        return url, urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(url).path))


class RomsLab:
    name = "romslab"
    direct = True
    base = "https://romslab.com"

    def search(self, query, pk=None):
        url = (f"{self.base}/wp-json/wp/v2/search?"
               f"search={urllib.parse.quote_plus(query)}&per_page=20")
        st, _, body = request(url, headers={"Accept": "application/json"}, retries=2)
        if st != 200:
            return []
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except Exception:
            return []
        out = []
        for x in data:
            link = x.get("url") or ""
            slug = link.rstrip("/").rsplit("/", 1)[-1].lower()
            if "switch" not in slug or "switch-2" in slug:
                continue
            title = re.sub(r"(?i)\s+switch\b.*$", "", clean(x.get("title") or ""))
            if title:
                out.append(Result(self.name, title, PLATFORM_LABELS["switch"], link,
                                  meta={"ext": "rar", "pk": "switch", "kind": "Base"}))
        return out

    def buttons(self, page):
        st, _, body = request(page, retries=2)
        if st != 200:
            raise RuntimeError(f"post unavailable ({st})")
        return re.findall(r'btn-download" target="_blank" href="([^"]+)">([^<]+)<',
                          body.decode("utf-8", "replace"))

    def extras(self, result):
        """link-only Base/Update/DLC buttons (datanodes etc.), typed from the button text."""
        return link_choices([(u, t) for u, t in self.buttons(result.page)
                             if "filekeeper.net" not in u])

    def resolve(self, result):
        btns = self.buttons(result.page)
        m = next((re.match(r"https://filekeeper\.net/([a-z0-9]{12})/(.+)", u)
                  for u, t in btns if t.strip() == "Mirror 2" and "filekeeper.net" in u), None)
        if not m:
            raise RuntimeError("no filekeeper mirror (captcha hosts only) — links: "
                               + " ".join([u for u, _ in btns][:4] or [result.page]))
        return (f"https://filekeeper.net/download?op=download2&id={m.group(1)}"
                "&method_free=Free+download&down_direct=1", urllib.parse.unquote(m.group(2)))


class ArchiveOrg:
    name = "archive.org"
    direct = True
    base = "https://archive.org"
    tags = {
        "nes": ("NES", ["nes", "zip"]), "snes": ("SNES", ["sfc", "smc", "zip"]),
        "n64": ("Nintendo 64", ["z64", "n64", "v64", "zip"]),
        "gb": ("Game Boy", ["gb", "zip"]), "gbc": ("Game Boy Color", ["gbc", "zip"]),
        "gba": ("Game Boy Advance", ["gba", "zip"]), "nds": ("Nintendo DS", ["nds", "zip"]),
        "3ds": ("Nintendo 3DS", ["cia", "3ds", "zip"]),
        "gc": ("GameCube", ["iso", "gcm", "zip"]), "wii": ("Wii", ["iso", "wbfs", "zip"]),
        "ps1": ("PlayStation", ["bin", "cue", "iso", "zip"]),
        "ps2": ("PlayStation 2", ["iso", "zip"]), "ps3": ("PlayStation 3", ["iso", "pkg", "zip"]),
        "psp": ("PlayStation Portable", ["iso", "cso", "pbp", "zip"]),
        "genesis": ("Genesis", ["md", "bin", "gen", "zip"]),
        "mastersystem": ("Master System", ["sms", "zip"]),
        "dreamcast": ("Dreamcast", ["cdi", "gdi", "chd", "zip"]),
        "saturn": ("Saturn", ["cue", "bin", "chd", "zip"]), "arcade": ("Arcade", ["zip"]),
        "switch": ("switch OR nsp OR xci OR nsz", ["nsp", "xci", "nsz", "7z", "zip", "rar"]),
    }
    index_query = ("mediatype:software AND -collection:loggedin AND "
                   "(subject:(nsp OR nsz OR xci OR switch) OR title:(nsp OR nsz OR xci OR switch)) "
                   "AND files_count:[3 TO *] AND item_size:[500000000 TO *]")

    def _refresh_index_bg(self):
        # serve the stale index now; rebuild it in a detached process that outlives this CLI run
        marker = INDEX_FILE + ".refreshing"
        try:
            if os.path.exists(marker) and time.time() - os.path.getmtime(marker) < 15 * 60:
                return
            open(marker, "w").close()
            code = ("from importlib.machinery import SourceFileLoader as L;"
                    f"L('rom', {os.path.abspath(__file__)!r}).load_module()"
                    ".SOURCES['archive.org'].switch_index(force=True)")
            kw = ({"creationflags": 0x00000008 | 0x00000200} if os.name == "nt"  # DETACHED | NEW_GROUP
                  else {"start_new_session": True})
            subprocess.Popen([sys.executable, "-c", code], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **kw)
        except Exception:
            pass

    def switch_index(self, force=False, on_progress=None):
        global INDEX_CACHE
        if INDEX_CACHE is not None and not force:
            return INDEX_CACHE
        if not force and os.path.exists(INDEX_FILE):
            try:
                d = json.load(open(INDEX_FILE))
                if d.get("ver") == INDEX_VER and d.get("items"):
                    INDEX_CACHE = d["items"]
                    if time.time() - d.get("fetched_at", 0) >= INDEX_TTL:
                        self._refresh_index_bg()
                    return INDEX_CACHE
            except Exception:
                pass
        url = (f"{self.base}/advancedsearch.php?q={urllib.parse.quote(self.index_query)}"
               "&fl%5B%5D=identifier&sort%5B%5D=item_size+desc&rows=500&output=json")
        st, _, body = request(url, retries=2, timeout=60)
        if st != 200:
            raise RuntimeError(f"archive.org search failed ({st})")
        idents = [d["identifier"] for d in
                  json.loads(body.decode("utf-8", "replace"))["response"]["docs"]]
        done = [0]
        lock = threading.Lock()

        def work(ident):
            try:
                st, _, body = request(f"{self.base}/metadata/{ident}", retries=2,
                                      headers={"Accept": "application/json"}, timeout=40)
                data = json.loads(body.decode("utf-8", "replace")) if st == 200 else {}
            except Exception:
                data = {}
            with lock:
                done[0] += 1
                if on_progress:
                    on_progress(done[0], len(idents))
            files = data.get("files") or []
            if (data.get("metadata") or {}).get("access-restricted-item") or any(
                    f.get("private") for f in files):
                return []
            return [{"id": ident, "name": f["name"], "size": int(f.get("size") or 0)}
                    for f in files if re.search(r"(?i)\.(nsp|nsz|xci)$", f["name"])]

        with ThreadPoolExecutor(max_workers=6) as pool:
            items = [e for batch in pool.map(work, idents) for e in batch]
        if not items:
            raise RuntimeError("archive.org Switch index is empty")
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = INDEX_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"fetched_at": time.time(), "ver": INDEX_VER, "items": items}, f)
            os.replace(tmp, INDEX_FILE)
        except Exception:
            pass
        INDEX_CACHE = items
        return items

    def index_results(self, query, force=False, on_progress=None):
        toks = significant(norm(query).split())
        groups, singles = {}, []
        for e in self.switch_index(force=force, on_progress=on_progress):
            fn = os.path.basename(e["name"])
            title = pretty_title(re.sub(r"\([^)]*\)", " ", fn))
            if not (toks and all(t in norm(title) for t in toks)):
                continue
            m = TID_RE.search(fn)
            if m:
                groups.setdefault(base_tid(m.group(1)), []).append((e, fn, title))
            else:
                singles.append(self._file_result(e, fn, title))
        out = [self._group_result(tid, files) for tid, files in groups.items()]
        return out + singles

    def _file_result(self, e, fn, title):
        return Result(self.name, title, PLATFORM_LABELS["switch"],
                      f"{self.base}/download/{e['id']}/{urllib.parse.quote(e['name'])}",
                      human(e["size"]),
                      meta={"pk": "switch", "ext": fn.rsplit(".", 1)[-1].lower(),
                            "kind": title_kind(fn), "bytes": e["size"], "filename": fn})

    def _group_result(self, tid, files):
        rel = lambda fn: int((re.search(r"\[v(\d+)\]", fn) or [0, 0])[1])
        order = {"Base": 0, "Update": 1, "DLC": 2}
        files.sort(key=lambda x: (order[title_kind(x[1])], -rel(x[1]), x[1]))
        choices = []
        for e, fn, _t in files:
            kind = title_kind(fn)
            choices.append({"label": choice_label(fn, kind), "kind": kind, "direct": True,
                            "url": f"{self.base}/download/{e['id']}/{urllib.parse.quote(e['name'])}",
                            "filename": fn, "size": human(e["size"]), "bytes": e["size"]})
        bases = [i for i, c in enumerate(choices) if c["kind"] == "Base"]
        ups = [i for i, c in enumerate(choices) if c["kind"] == "Update"]
        default = []
        if bases:  # prefer .nsp, then the first (sorted) base file
            default.append(next((i for i in bases if choices[i]["filename"].lower().endswith(".nsp")),
                                bases[0]))
        if ups:
            default.append(ups[0])  # newest release sorts first
        for i in default:
            choices[i]["default"] = True
        head = choices[default[0]] if default else choices[0]
        title = pretty_title(re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", head["filename"])).rstrip(" +-_")
        n_up = len(ups)
        n_dlc = sum(c["kind"] == "DLC" for c in choices)
        summary = " · ".join(x for x in (f"+{n_up} upd" if n_up else "",
                                         f"{n_dlc} DLC" if n_dlc else "") if x)
        first = choices[default[0]] if default else head
        return Result(self.name, title, PLATFORM_LABELS["switch"], first["url"], first["size"],
                      meta={"pk": "switch", "ext": first["filename"].rsplit(".", 1)[-1].lower(),
                            "kind": "Base" if bases else "no base", "tid": tid,
                            "bytes": first["bytes"], "filename": first["filename"],
                            "choices": choices, "summary": summary})

    skip = ("_files.xml", "_meta.xml", "_meta.sqlite", "_archive.torrent", ".torrent")
    port_queries = (
        'title:("switch port") AND mediatype:software',
        'title:("homebrew port") AND mediatype:software',
        'title:(nsp) AND (port OR homebrew) AND mediatype:software',
        'title:("nintendo switch") AND (port OR homebrew) AND mediatype:software',
    )
    port_exts = ["nsp", "xci", "nsz", "zip", "7z", "rar"]

    def switch_ports(self, force=False, on_progress=None):
        global PORTS_CACHE
        if PORTS_CACHE is not None and not force:
            return PORTS_CACHE
        if not force and os.path.exists(PORTS_FILE):
            try:
                d = json.load(open(PORTS_FILE))
                if (time.time() - d.get("fetched_at", 0) < PORTS_TTL
                        and d.get("ver") == PORTS_VER and d.get("items")):
                    PORTS_CACHE = d["items"]
                    return PORTS_CACHE
            except Exception:
                pass
        pair, seen = [], set()
        for q in self.port_queries:
            url = (f"{self.base}/advancedsearch.php?q={urllib.parse.quote(q)}"
                   "&fl%5B%5D=identifier&fl%5B%5D=title&rows=60&output=json")
            st, _, body = request(url, retries=2)
            if st != 200:
                continue
            try:
                docs = json.loads(body.decode("utf-8", "replace"))["response"]["docs"]
            except Exception:
                continue
            for doc in docs:
                ident = doc.get("identifier")
                if ident and ident not in seen:
                    seen.add(ident)
                    pair.append((ident, clean(doc.get("title") or "")))
        out, state = [], {"done": 0}

        def work(item):
            ident, title = item
            try:
                st, _, body = request(f"{self.base}/metadata/{ident}", retries=2,
                                      headers={"Accept": "application/json"}, timeout=40)
                data = json.loads(body.decode("utf-8", "replace")) if st == 200 else {}
            except Exception:
                data = {}
            state["done"] += 1
            if on_progress:
                on_progress(state["done"], len(pair))
            files = [f for f in data.get("files", []) if not f["name"].endswith(self.skip)]
            for ext in self.port_exts:
                cands = [f for f in files if f["name"].lower().endswith("." + ext)]
                if cands:
                    best = max(cands, key=lambda f: int(f.get("size") or 0))
                    return {"title": title or pretty_title(best["name"]), "ident": ident,
                            "size": int(best.get("size") or 0), "file": best["name"],
                            "nsp": ext in ("nsp", "xci", "nsz")}
            return None

        with ThreadPoolExecutor(max_workers=6) as pool:
            for r in pool.map(work, pair):
                if r:
                    out.append(r)
        block = ("theme", "dbi", "installer", "autoloader", "payload", "firmware",
                 "devkitpro", "source code", "godot", "psvita", "ps vita", " vita",
                 "3ds", "psp", "wiiu", "wii u")
        out = [r for r in out if not any(b in r["title"].lower() for b in block)]
        out.sort(key=lambda x: (not x.get("nsp"), norm(x["title"])))
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = PORTS_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"fetched_at": time.time(), "ver": PORTS_VER, "items": out}, f)
            os.replace(tmp, PORTS_FILE)
        except Exception:
            pass
        PORTS_CACHE = out
        return out

    def port_results(self, force=False, on_progress=None):
        out = []
        for it in self.switch_ports(force=force, on_progress=on_progress):
            out.append(Result(self.name, it["title"], PLATFORM_LABELS["switch"],
                              f"{self.base}/details/{it['ident']}",
                              human(it["size"]) if it["size"] else "",
                              meta={"exts": self.port_exts, "ext": "nsp",
                                    "pk": "switch", "kind": "Port"}))
        return out

    def search(self, query, platform_key=None, on_progress=None, force=False):
        if platform_key == "switchindex":
            return self.index_results(query, force=force, on_progress=on_progress)
        if platform_key not in self.tags:
            return []
        tag, exts = self.tags[platform_key]
        q = f'title:({query}) AND mediatype:software AND ({tag})'
        url = (f"{self.base}/advancedsearch.php?q={urllib.parse.quote(q)}"
               "&fl%5B%5D=identifier&fl%5B%5D=title&rows=20&page=1&output=json")
        st, _, body = request(url, retries=2)
        if st != 200:
            return []
        try:
            docs = json.loads(body.decode("utf-8", "replace"))["response"]["docs"]
        except Exception:
            return []
        out = []
        for doc in docs:
            title = clean(doc.get("title") or "")
            if title:
                out.append(Result(self.name, title, PLATFORM_LABELS.get(platform_key, platform_key),
                                  f"{self.base}/details/{doc['identifier']}", meta={"exts": exts}))
        return out

    def resolve(self, result):
        if result.meta.get("url"):  # one picked choice of a grouped result
            return result.meta["url"], result.meta.get("filename") or result.title
        if "/download/" in result.page:
            return result.page, result.meta.get("filename") or result.title
        ident = result.page.rsplit("/", 1)[-1]
        st, _, body = request(f"{self.base}/metadata/{ident}", retries=2,
                              headers={"Accept": "application/json"})
        if st != 200:
            raise RuntimeError(f"item unavailable ({st})")
        data = json.loads(body.decode("utf-8", "replace"))
        files = [f for f in data.get("files", []) if not f["name"].endswith(self.skip)]
        if not files:
            raise RuntimeError("item has no downloadable file")
        for ext in result.meta.get("exts", []):
            matches = [f for f in files if f["name"].lower().endswith("." + ext)]
            if matches:
                best = max(matches, key=lambda f: int(f.get("size") or 0))
                return (f"{self.base}/download/{ident}/{urllib.parse.quote(best['name'])}",
                        best["name"])
        loose = [f for f in files if re.search(r"\.(zip|7z|rar|ips|bps|xdelta|iso|bin|cue|chd|cia|3ds|nsp|xci)$",
                                               f["name"], re.I)]
        if loose:
            best = max(loose, key=lambda f: int(f.get("size") or 0))
            return f"{self.base}/download/{ident}/{urllib.parse.quote(best['name'])}", best["name"]
        raise RuntimeError("no compatible format in the item")


class NoPayStation:
    name = "nps"
    direct = True
    base = "https://nopaystation.com/tsv/"
    tsv = {"ps3": "PS3_GAMES.tsv", "psv": "PSV_GAMES.tsv",
           "psp": "PSP_GAMES.tsv", "ps1": "PSX_GAMES.tsv"}
    cache_file = os.path.join(CACHE_DIR, "nps.json")
    _cache = None
    _lock = threading.Lock()

    def _fetch(self, key):
        st, _, body = request(self.base + self.tsv[key], timeout=120, retries=3)
        if st != 200:
            return []
        lines = body.decode("utf-8", "replace").splitlines()
        if not lines:
            return []
        hdr = [h.strip().lower() for h in lines[0].split("\t")]
        i_size = next((i for i, n in enumerate(hdr) if "size" in n), None)
        i_orig = next((i for i, n in enumerate(hdr) if "original name" in n), None)
        rows = []
        for line in lines[1:]:
            c = line.split("\t")
            url = next((x for x in c if x.startswith("http")), None)
            if not url or len(c) < 3:
                continue
            size = 0
            if i_size is not None and i_size < len(c):
                digits = re.sub(r"[^0-9]", "", c[i_size])
                size = int(digits) if digits else 0
            orig = c[i_orig] if i_orig is not None and i_orig < len(c) else ""
            rows.append({"tid": c[0], "region": c[1] if len(c) > 1 else "",
                         "name": c[2], "url": url, "size": size, "orig": orig})
        return rows

    def load(self, force=False, on_progress=None):
        with self._lock:
            if NoPayStation._cache and not force:
                return NoPayStation._cache
            if not force and os.path.exists(self.cache_file):
                try:
                    d = json.load(open(self.cache_file))
                    if time.time() - d.get("fetched_at", 0) < 7 * 86400 and d.get("data"):
                        NoPayStation._cache = d["data"]
                        return NoPayStation._cache
                except Exception:
                    pass
            data = {}
            for i, k in enumerate(self.tsv, 1):
                if on_progress:
                    on_progress(i, len(self.tsv))
                data[k] = self._fetch(k)
            try:
                os.makedirs(CACHE_DIR, exist_ok=True)
                tmp = self.cache_file + ".tmp"
                with open(tmp, "w") as f:
                    json.dump({"fetched_at": time.time(), "data": data}, f)
                os.replace(tmp, self.cache_file)
            except Exception:
                pass
            NoPayStation._cache = data
            return data

    def _result(self, e, pk):
        title = pretty_title(e["name"])
        return Result(
            self.name, title, PLATFORM_LABELS.get(pk, "PS3"), e["url"],
            human(e["size"]) if e["size"] else "",
            meta={"ext": "pkg", "bytes": e["size"], "tid": e["tid"], "pk": pk,
                  "filename": f"{title} [{e['tid']}].pkg"})

    def search(self, query, pk=None, on_progress=None, force=False):
        rows = self.load(force=force, on_progress=on_progress).get(pk or "ps3", [])
        toks = significant(norm(query).split())
        scored = []
        for e in rows:
            nt = norm(f"{e['name']} {e['orig']}")
            hits = sum(1 for t in toks if t in nt)
            if hits:
                scored.append((hits, e))
        scored.sort(key=lambda x: (-x[0], len(x[1]["name"])))
        return [self._result(e, pk) for _hits, e in scored[:80]]

    def all_items(self, pk=None):
        rows = self.load().get(pk or "ps3", [])
        out = [self._result(e, pk) for e in rows]
        out.sort(key=lambda r: norm(r.title))
        return out

    def resolve(self, result):
        return result.page, result.meta.get("filename") or result.title


class DlpsGame:
    name = "dlpsgame"
    direct = False  # host links; only pixeldrain/mediafire/gdrive/1fichier resolve
    base = "https://dlpsgame.com"
    keys = ("ps5", "ps4", "ps3")
    ext = "pkg"
    HOSTS = ("drive.google.com", "docs.google.com", "mediafire.com", "1fichier.com",
             "gofile.io", "akirabox", "vikingfile", "rootz.so", "1cloudfile.com",
             "ranoz.gg", "mega.nz", "megaup.net", "send.now", "datanodes.to", "frdl.",
             "multiup.io", "buzzheavier.com", "pixeldrain.com")

    def search(self, query, pk=None, on_progress=None, force=False):
        url = (f"{self.base}/wp-json/wp/v2/search?"
               f"search={urllib.parse.quote_plus(query)}&per_page=20")
        st, _, body = request(url, headers={"Accept": "application/json"}, retries=2)
        if st != 200:
            return []
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except Exception:
            return []
        out = []
        for x in data:
            link = x.get("url") or ""
            slug = link.rstrip("/").rsplit("/", 1)[-1].lower()
            key = next((k for k in self.keys if k in slug), None)
            if not key or (pk and key != pk):
                continue
            title = clean(x.get("title") or "")
            if title:
                out.append(Result(self.name, title, PLATFORM_LABELS[key], link,
                                  meta={"ext": self.ext, "pk": key}))
        return out

    def links(self, page):
        st, _, body = request(page, retries=2)
        if st != 200:
            return []
        h = body.decode("utf-8", "replace")
        urls = []
        for u in re.findall(r'href="(https?://[^"]+)"', h):
            u = htmllib.unescape(u)
            if any(x in u for x in self.HOSTS) and u not in urls:
                urls.append(u)
        return urls

    def extras(self, result):
        """every host link in the post, typed Base/Update/DLC from its URL."""
        return link_choices([(u, u) for u in self.links(result.page)])

    def resolve(self, result):
        links = result.meta.get("links") or self.links(result.page)
        if not links:
            raise RuntimeError(f"no links in the post — open {result.page}")
        order = []
        for host in ("pixeldrain", "mediafire", "google", "1fichier", "gofile", "akirabox",
                     "vikingfile", "rootz", "1cloudfile", "ranoz", "mega"):
            order += [u for u in links if host in u and u not in order]
        order += [u for u in links if u not in order]
        errors = []
        for u in order:
            try:
                if "pixeldrain.com" in u:
                    return self._pixeldrain(u), ""
                if "mediafire.com" in u:
                    d, n = self._mediafire(u)
                    return d, n
                if "google.com" in u:
                    return self._gdrive(u), ""
                if "1fichier.com" in u:
                    d = self._1fichier(u)
                    if d:
                        return d, urllib.parse.unquote(os.path.basename(
                            urllib.parse.urlparse(d).path)) or ""
                    errors.append("1fichier has no free slot")
            except Exception as e:
                errors.append(f"{u.split('/')[2]}: {e}")
        raise RuntimeError("direct download unavailable (" + "; ".join(errors or ["host JS"])
                           + ") — links: " + " ".join(order[:4]))

    def _mediafire(self, u):
        m = re.search(r"/file/[^/]+/([^/]+)", u)
        name = urllib.parse.unquote(m.group(1)) if m else ""
        st, _, body = request(u, retries=2)
        d = re.search(r'href="(https://download[^"]+\.mediafire\.com/[^"]+)"',
                      body.decode("utf-8", "replace"))
        if not d:
            raise RuntimeError("mediafire link not found")
        return d.group(1), name

    def _pixeldrain(self, u):
        m = re.search(r"pixeldrain\.com/(?:u|api/file)/(\w+)", u)
        if not m:
            raise RuntimeError("pixeldrain id not found")
        return f"https://pixeldrain.com/api/file/{m.group(1)}?download"

    def _gdrive(self, u):
        m = re.search(r"/(?:file/d/|id=)([A-Za-z0-9_-]{20,})", u)
        if not m:
            raise RuntimeError("drive id not found")
        return (f"https://drive.usercontent.google.com/download?id={m.group(1)}"
                "&export=download&confirm=t")

    def _1fichier(self, u):
        st, _, body = request(u, retries=2)
        h = body.decode("utf-8", "replace")
        m = re.search(r'href="(https?://[a-z0-9]+\.1fichier\.com/[^"]+)"[^>]*class="ok"', h)
        if m:
            return htmllib.unescape(m.group(1))
        st, _, body = request(u, data=b"ad=1", retries=2, headers={
            "Content-Type": "application/x-www-form-urlencoded", "Referer": u})
        h = body.decode("utf-8", "replace")
        m = re.search(r'(https?://[a-z0-9]+\.1fichier\.com/[^"\']+\.(?:pkg|zip|rar|7z|iso|part\d+|bin))', h)
        return htmllib.unescape(m.group(1)) if m else None


# Switch sister site of dlpsgame; its posts link file hosts that mostly need a browser.
class NswGame(DlpsGame):
    name = "nswgame"
    base = "https://nswgf.com"
    keys = ("switch",)
    ext = "nsp"

    def resolve(self, result):
        # posts also link save files/mods; keep links that name a Switch package, plus
        # direct hosts whose URLs carry no filename
        links = self.links(result.page)
        result.meta["links"] = [u for u in links if re.search(r"(?i)ns[pz]|xci|pixeldrain", u)] or links
        return super().resolve(result)


NPS = NoPayStation()
DLP = DlpsGame()
RF = RomsFun()
SOURCES = {"romsgames": RomsGames(), "romsfun": RF, "romslab": RomsLab(), "archive.org": ArchiveOrg(),
           "nps": NPS, "dlpsgame": DLP, "nswgame": NswGame()}


def merge_dupes(results):
    """TUI only: fold same (title, platform) rows from different sources into the best-ranked one.
    A Title-ID group joins the row as an alt, so its versions show in the detail panel."""
    out, by_key = [], {}
    for r in results:
        k = (norm(r.title), r.platform)
        first = by_key.get(k)
        if first is None:
            by_key[k] = r
            out.append(r)
            continue
        taken = {first.source} | {a.source for a in first.meta.get("alts", [])}
        group_alt = r.meta.get("choices") and not any(a.meta.get("choices")
                                                      for a in [first] + first.meta.get("alts", []))
        if r.source not in taken or group_alt:
            first.meta.setdefault("alts", []).append(r)
        else:
            out.append(r)  # same source twice (e.g. two regions): keep both rows
    return out


def rank(results, query):
    words = significant(norm(query).split())

    def score(r):
        t = norm(f"{r.title} {r.platform}")
        s = sum(7 for w in words if w in t)
        if words and all(w in t for w in words):
            s += 30
        low = r.title.lower()
        for pat in BAD:
            if pat in low:
                s -= 12
        if r.meta.get("ext") in ("nsp", "xci"):
            s += 4
        pop = r.meta.get("pop")
        if pop is not None:
            s += min(12, max(2, 14 - pop))
        if r.kind == "Base":
            s += 3
        elif r.kind in ("Update", "DLC"):
            s -= 3
        if r.source == "archive.org":
            s -= 8
        if r.source == "dlpsgame":
            s -= 5
        elif r.source == "nswgame":
            s -= 12
        if len(r.title) > 70:
            s -= 6
        return s

    return sorted(results, key=score, reverse=True)


def search(query, platform_key=None, on_progress=None, force=False):
    results, seen = [], set()

    def add(batch):
        for r in batch:
            key = (r.source, r.title, r.size)
            if key not in seen:
                seen.add(key)
                results.append(r)

    words = significant(norm(query).split())
    tries = [query]
    if len(words) >= 2:
        tries.append(" ".join(words))
        tries.append(" ".join(words[:2]))
    tries += sorted(words, key=len, reverse=True)[:2]

    def run(fn, *a, **k):
        try:
            return fn(*a, **k)
        except Exception:
            return []

    first = True
    for attempt in tries:
        jobs = []
        if platform_key:
            for src_name, arg in PLATFORMS[platform_key]:
                src = SOURCES[src_name]
                if src_name == "nps" or arg == "switchindex":
                    jobs.append((src.search, (attempt, arg),
                                 {"on_progress": on_progress, "force": force}))
                else:
                    jobs.append((src.search, (attempt, arg), {}))
        else:
            jobs += [(SOURCES["romsgames"].search, (attempt,), {}), (RF.search, (attempt,), {})]
            if first:
                jobs.append((NPS.search, (attempt, "ps3"),
                             {"on_progress": on_progress, "force": force}))
                jobs += [(s.search, (attempt, None), {})
                         for s in (DLP, SOURCES["nswgame"], SOURCES["romslab"])]
        if jobs:
            # map() yields in submission order, so merging stays deterministic
            with ThreadPoolExecutor(max_workers=len(jobs)) as pool:
                for batch in pool.map(lambda j: run(j[0], *j[1], **j[2]), jobs):
                    add(batch)
        force = False
        first = False
        if len(results) >= 12:
            break

    if platform_key == "switchports":
        try:
            words = significant(norm(query).split())
            for r in SOURCES["archive.org"].port_results(force=force):
                if all(w in norm(r.title) for w in words):
                    add([r])
        except Exception:
            pass
        results = [r for r in results if r.kind == "Port"]
        seen = {(r.source, r.title, r.size) for r in results}
    if (platform_key and len(results) < 6 and platform_key in ArchiveOrg.tags
            and ("archive.org", platform_key) not in PLATFORMS[platform_key]):
        try:
            add(ArchiveOrg().search(query, platform_key=platform_key))
        except Exception:
            pass
    annotate_popular(results)
    return results


def fmt_row(r, i):
    size = f"{r.size:>9}" if r.size else " " * 9
    kind = f"{r.kind:<6}" if r.kind else " " * 6
    star = "★ " if r.meta.get("pop") is not None else ""
    return f"{i:>2}  {r.platform[:11]:<11} {kind} {size}  {star}{r.title[:52]}"


def show(results, limit=15):
    write()
    write(f"  {'#':>2}  {'platform':<11} {'type':<6} {'size':>9}  title")
    write("  " + "-" * 80)
    for i, r in enumerate(results[:limit], 1):
        write("  " + fmt_row(r, i))
    write()


def select_menu(results, limit=15):
    items = results[:limit]
    if os.name == "nt":
        import msvcrt
        os.system("")  # ponytail: turns on ANSI escape handling in the Windows console

        def key():
            ch = msvcrt.getwch()
            if ch in ("\x00", "\xe0"):  # arrow keys arrive as a prefix + scan code
                return {"H": "up", "P": "down"}.get(msvcrt.getwch(), "")
            return ch

        def restore():
            pass
    else:
        import select as _select
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)

        def key():
            ch = os.read(fd, 1).decode("utf-8", "replace")
            if ch != "\x1b":
                return ch
            seq = b""
            stop = time.time() + 0.4
            while time.time() < stop:
                if _select.select([fd], [], [], 0.05)[0]:
                    try:
                        seq += os.read(fd, 64)
                    except OSError:
                        break
                    if seq.endswith((b"A", b"B")):
                        break
                elif seq:
                    break
            return "up" if seq.endswith(b"A") else "down" if seq.endswith(b"B") else ""

        def restore():
            termios.tcsetattr(fd, termios.TCSADRAIN, old)

    idx, chosen, n_lines = 0, set(), 0
    try:
        sys.stdout.write("\033[?25l")
        while True:
            if n_lines:
                sys.stdout.write(f"\033[{n_lines}A")
            lines = [f"  ↑↓ move · space mark · Enter download · q cancel — {len(items)} found"]
            for i, r in enumerate(items):
                mark = "❯" if i == idx else " "
                line = f"  {mark} {'✔' if i in chosen else ' '} {fmt_row(r, i + 1)}"
                if i == idx:
                    line = "\033[7m" + line + "\033[0m"
                lines.append(line)
            write("\033[J")
            write("\n".join(lines) + "\n")
            n_lines = len(lines)
            ch = key()
            if ch == "up":
                idx = max(0, idx - 1)
            elif ch == "down":
                idx = min(len(items) - 1, idx + 1)
            elif ch in ("\r", "\n"):
                return [items[i] for i in sorted(chosen)] or [items[idx]]
            elif ch == " ":
                chosen.symmetric_difference_update({idx})
            elif ch in ("q", "Q", "\x03"):
                return []
            elif ch.isdigit():
                num = int(ch)
                if 1 <= num <= len(items):
                    idx = num - 1
    finally:
        write("\033[?25h")
        restore()
        write("\n")


def validate(path):
    size = os.path.getsize(path) if os.path.exists(path) else 0
    if size < 1024:
        return False
    if size > 50 * 1024 * 1024:
        return True
    name = path.lower()
    if name.endswith(".zip"):
        with open(path, "rb") as f:
            head = f.read(4)
        return head.startswith(b"PK") or zipfile.is_zipfile(path)
    if name.endswith(".7z"):
        with open(path, "rb") as f:
            return f.read(3) == b"7z\xbc"
    if name.endswith(".nsp"):
        with open(path, "rb") as f:
            return f.read(4) == b"PFS0"
    if name.endswith(".pkg"):
        with open(path, "rb") as f:
            return f.read(4) in (b"\x7fPKG", b"\x7fCNT")
    if name.endswith(".rar"):
        with open(path, "rb") as f:
            return f.read(6) == b"Rar!\x1a\x07"
    return True


def ext_for(result, name, url):
    for cand in (name, urllib.parse.urlparse(url).path):
        m = EXT_RE.search(cand or "")
        if m:
            return "." + m.group(1).lower()
    if result.meta.get("ext"):
        return "." + result.meta["ext"]
    return ".nsp" if result.platform == "Switch" else ".zip"


def fix_magic_ext(path):
    try:
        with open(path, "rb") as f:
            head = f.read(8)
    except OSError:
        return path
    for magic, ext in ((b"PK\x03\x04", ".zip"), (b"Rar!", ".rar"), (b"7z\xbc", ".7z"),
                       (b"PFS0", ".nsp"), (b"HEAD", ".xci"), (b"\x7fPKG", ".pkg"),
                       (b"\x7fCNT", ".pkg")):
        if head.startswith(magic):
            root, cur = os.path.splitext(path)
            if cur.lower() != ext:
                new = root + ext
                new = unique_path(new)
                os.replace(path, new)
                return new
            return path
    return path


def expand_choices(result):
    """One Result per file to download: picked choices, else defaults; plain results pass through."""
    choices = result.meta.get("choices")
    if not choices:
        return [result]
    picked = result.meta.get("picked")
    idx = picked if picked is not None else [i for i, c in enumerate(choices) if c.get("default")]
    out = []
    for i in idx:
        c = choices[i]
        if not c.get("direct"):
            continue
        m = dict(result.meta, url=c["url"], filename=c.get("filename"), kind=c["kind"],
                 ext=(c.get("filename") or "").rsplit(".", 1)[-1].lower() or result.meta.get("ext"))
        m.pop("choices", None)
        m.pop("picked", None)
        out.append(Result(result.source, f"{result.title} · {c['label']}", result.platform,
                          c["url"], c.get("size", ""), meta=m))
    return out


def download(result, outdir, on_progress=None, cancel=None):
    if on_progress:
        on_progress(0, 0, f"looking for: {result.title[:45]}…")
    if result.meta.get("search_title"):
        title = result.meta["search_title"]
        found = rank(search(title, result.meta.get("pk")), title)
        if not found:
            raise RuntimeError(f"could not find '{result.title}'")
        result = found[0]
    jobs = expand_choices(result)
    if len(jobs) != 1:
        if not jobs:
            raise RuntimeError("nothing to download (base not available; pick a file with i)")
        return [download(j, outdir, on_progress, cancel) for j in jobs][-1]
    result = jobs[0]
    src = SOURCES[result.source]
    if on_progress:
        on_progress(0, 0, f"getting link: {result.title[:45]}…")
    url, name = src.resolve(result)
    ext = ext_for(result, name, url)
    folder = os.path.join(outdir, re.sub(r'[\\/:*?"<>|]', "", result.platform or "outros"))
    os.makedirs(folder, exist_ok=True)
    path = unique_path(os.path.join(folder, safe_name(name or result.title, "rom", ext)))
    start = time.time()

    def cb(read, total):
        if not on_progress:
            return
        pct = read * 100 / total if total else 0
        bps = read / max(time.time() - start, 0.1)
        on_progress(read, total, f"{pct:5.1f}%  {human(read)}/{human(total)}  "
                                 f"{bps / 1048576:.1f} MB/s")

    stream(url, result.page if result.source != "nps" else None, cb, path, cancel)
    path = fix_magic_ext(path)
    if not validate(path):
        try:
            os.remove(path)
        except OSError:
            pass
        raise RuntimeError("invalid file (expired link?)")
    return path


def run_cli_download(picked, outdir):
    ok = 0
    for i, r in enumerate(picked, 1):
        write()
        write(f"  [{i}/{len(picked)}] {r.title} ({r.platform})")
        try:
            path = download(r, outdir, on_progress=lambda a, b, m: status(f"   {m}"))
            clear_status()
            write(f"  ✔ done: {path}  ({human(os.path.getsize(path))})")
            ok += 1
        except Exception as e:
            clear_status()
            write(f"  ✖ failed: {e}")
    write()
    write(f"  {ok}/{len(picked)} downloaded to {outdir}")
    return 0 if ok else 1


