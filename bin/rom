#!/usr/bin/env python3
"""rom — search and download ROMs, ISOs and Switch games from the terminal.

Usage:
  rom                          # interactive UI (Textual)
  rom "zelda"                  # search directly and show the menu
  rom -p switch "mario kart"   # filter by platform
  rom -y -p snes "metroid"     # download the best match without asking
  rom --list "metroid"         # list only, no download
  rom --print-url -p switch …  # print the direct link and exit
  rom -l                       # list the platforms
  rom --refresh                # rebuild the catalog index
"""

